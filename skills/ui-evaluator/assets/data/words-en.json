    "error_generic": {
      "rule": "CPY-04",
      "level": "gate",
      "static_level": "advisory",
      "description": "Generic or code-only error messages. A static hit in source stays a candidate (reported under advisory CPY-09) until the error state is exercised (CPY-04). Generic messages fail only when they stand without a fix, so patterns match whole messages.",
      "entries": [
        {
          "text": "An error occurred",
          "pattern": "^an? (?:unexpected |unknown )?error (?:has )?occurred[.!]?$"
        },
        {
          "text": "Something went wrong",
          "pattern": "^(?:oops[,!.]?\\s*)?something went wrong[.!]?$"
        },
        {
          "text": "Invalid",
          "pattern": "^invalid(?: (?:input|value|entry|data|field|request))?[.!]?$"
        },
        {
          "text": "Oops",
          "pattern": "^oops\\b"
        },
        {
          "text": "a raw error code alone",
          "pattern": "^(?:error\\s*)?(?:code\\s*)?[:#]?\\s*(?:[A-Z]{1,6}[-_])?\\d{3,5}$"
        },
        {
          "text": "Error",
          "pattern": "^error[.!]?$",
          "heuristic": true
        },
        {
          "text": "Unknown error",
          "pattern": "^unknown error[.!]?$",
          "heuristic": true
        },
        {
          "text": "Request failed",
          "pattern": "^request failed[.!]?$",
          "heuristic": true
        },
        {
          "text": "Failed",
          "pattern": "^failed[.!]?$",
          "heuristic": true
        }
      ]
    },
