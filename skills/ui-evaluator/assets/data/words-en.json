    "ai_buzzwords": {
      "rule": "SLP-14",
      "level": "gate",
      "table": "B",
      "evidence": "any hit is SLP-14 evidence on its own",
      "adapted_from": "impeccable buzzword list (Apache-2.0) with additions from gstack and taste-skill (MIT), re-expressed in content-copy.md Table B",
      "entries": [
        {
          "text": "supercharge",
          "kind": "hype_verb",
          "pattern": "\\bsupercharg(?:e|es|ed|ing)\\b"
        },
        {
          "text": "unleash",
          "kind": "hype_verb",
          "pattern": "\\bunleash(?:es|ed|ing)?\\b"
        },
        {
          "text": "unlock the power of",
          "kind": "hype_verb",
          "pattern": "\\bunlock(?:s|ed|ing)? the (?:full |true )?power of\\b"
        },
        {
          "text": "harness the power of",
          "kind": "hype_verb",
          "pattern": "\\bharness(?:es|ed|ing)? the (?:full |true )?power of\\b"
        },
        {
          "text": "leverage (the power of)",
          "kind": "hype_verb",
          "pattern": "\\bleverag(?:e|es|ed|ing)\\b",
          "note": "also Table A; a word in both tables counts as Table B",
          "technical": true
        },
        {
          "text": "revolutionize",
          "kind": "hype_verb",
          "pattern": "\\brevolutioni[sz](?:e|es|ed|ing)\\b"
        },
        {
          "text": "elevate",
          "kind": "hype_verb",
          "pattern": "\\belevat(?:e|es|ing)\\b",
          "note": "base verb forms only; 'elevated access' and 'elevation' are literal",
          "literal_after": "^\\s+(?:the|your|their|his|her|both)?\\s*(?:injured\\s+)?(?:legs?|feet|foot|arms?|head|bed|limbs?|ankles?|knees?|wrists?|hands?)\\b",
          "literal_note": "medical and physical uses: elevate your legs"
        },
        {
          "text": "empower",
          "kind": "hype_verb",
          "pattern": "\\bempower(?:s|ed|ing|ment)?\\b"
        },
        {
          "text": "streamline",
          "kind": "hype_verb",
          "pattern": "\\bstreamlin(?:e|es|ed|ing)\\b",
          "technical": true
        },
        {
          "text": "seamless",
          "kind": "inflated_adjective",
          "pattern": "\\bseamless(?:ly)?\\b",
          "literal_after": "^\\s+(?:[\\p{L}-]+\\s+)?(?:gutters?|guttering|downpipes?|downspouts?|pipes?|piping|tubes?|tubing|steel|aluminium|aluminum|copper|vinyl|knit(?:ted|wear)?|leggings|bras?|garments?|socks?|stockings?|tights|underwear|patterns?|textures?|tiles?|tiling|backgrounds?|loops?|looping|roll|paper|backdrops?|floor(?:s|ing)?|wallpaper|resin|welds?|welded|welding|joints?|seams?|boundar(?:y|ies)|edges?|blend(?:s|ing)?|cloning|composit\\w*|stitch\\w*|panoram\\w*)\\b",
          "literal_note": "physical and material uses (seamless gutters, steel tubing, knitwear, tiling patterns, video loops, backdrop paper) and image compositing (a seamless boundary, seamless cloning)"
        },
        {
          "text": "effortless",
          "kind": "inflated_adjective",
          "pattern": "\\beffortless(?:ly)?\\b"
        },
        {
          "text": "robust",
          "kind": "inflated_adjective",
          "pattern": "\\brobust\\b",
          "literal_after": "^\\s+(?:(?:to|against)\\b|(?:[\\p{L}-]+\\s+)?(?:coat(?:ing)?s?|construction|frames?|casing|hinges?|enamel|materials?|steel|timber|packaging|standard errors?|regression|estimat\\w*|statistics?|control(?:ler)?|optimi[sz]ation|objective|loss(?:es)?|training|inference|covariance|fitting|classifier|learning|features?|PCA|counterpart|variant|baseline|solution|solver)\\b)",
          "literal_note": "physical sturdiness, statistics and machine learning: a robust coat of enamel, robust standard errors, robust training, robust to noise",
          "technical": true
        },
        {
          "text": "best-in-class",
          "kind": "inflated_adjective",
          "pattern": "\\bbest[- ]in[- ]class\\b"
        },
        {
          "text": "world-class",
          "kind": "inflated_adjective",
          "pattern": "\\bworld[- ]class\\b"
        },
        {
          "text": "enterprise-grade",
          "kind": "inflated_adjective",
          "pattern": "\\benterprise[- ]grade\\b"
        },
        {
          "text": "next-generation",
          "kind": "inflated_adjective",
          "pattern": "\\bnext[- ]generation\\b"
        },
        {
          "text": "next-gen",
          "kind": "inflated_adjective",
          "pattern": "\\bnext[- ]gen\\b"
        },
        {
          "text": "cutting-edge",
          "kind": "inflated_adjective",
          "pattern": "\\bcutting[- ]edge\\b"
        },
        {
          "text": "mission-critical",
          "kind": "inflated_adjective",
          "pattern": "\\bmission[- ]critical\\b"
        },
        {
          "text": "future-proof",
          "kind": "inflated_adjective",
          "pattern": "\\bfuture[- ]proof(?:ed|ing)?\\b"
        },
        {
          "text": "game-changing",
          "kind": "inflated_adjective",
          "pattern": "\\bgame[- ]chang(?:ing|er|ers)\\b"
        }
      ],
      "description": "Table B buzzwords: any hit is SLP-14 evidence, except literal and domain uses (content-copy.md CPY-19 exceptions). `literal_after` lists the physical or technical nouns that make a use literal (seamless gutters, a robust coat of enamel); a collocation that PRODUCT.md itself uses also counts as a domain use."
    },
    "theatre_phrases": {
      "rule": "SLP-14",
      "level": "gate",
      "table": "B",
      "evidence": "any hit is SLP-14 evidence on its own",
      "entries": [
        {
          "text": "built for the way you work",
          "pattern": "\\bbuilt for the way you work\\b"
        },
        {
          "text": "designed for teams like yours",
          "pattern": "\\bdesigned for teams like yours\\b"
        },
        {
          "text": "meet your new …",
          "pattern": "\\bmeet your new\\b"
        },
        {
          "text": "the future of …",
          "pattern": "\\bthe future of\\b"
        },
        {
          "text": "ship faster",
          "pattern": "\\bship faster\\b"
        },
        {
          "text": "dismissing something as … theater",
          "pattern": "\\b(?:security|productivity|compliance|innovation|privacy|agile|process|meeting|status|growth|hustle|busywork|planning|alignment) theat(?:er|re)\\b",
          "heuristic": true,
          "note": "the catalogue names the construction; the noun list is UI-Evaluator's rendering"
        }
