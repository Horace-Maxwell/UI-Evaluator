    "placeholder_text": {
      "rule": "CPY-01",
      "level": "gate",
      "description": "Placeholder text shipped as content. Visibly labelled placeholders such as [price to confirm] pass. Unrendered interpolation and leaked values (undefined, null, NaN, [object Object]) are checked on rendered text by `uie audit --checks copy`.",
      "entries": [
        {
          "text": "lorem ipsum",
          "pattern": "\\blorem ipsum\\b"
        },
        {
          "text": "dolor sit amet",
          "pattern": "\\bdolor sit amet\\b"
        },
        {
          "text": "TODO",
          "pattern": "\\bTODO\\b",
          "flags": "u"
        },
        {
          "text": "TBD",
          "pattern": "\\bTBD\\b",
          "flags": "u"
        },
        {
          "text": "FIXME",
          "pattern": "\\bFIXME\\b",
          "flags": "u",
          "heuristic": true
        },
        {
          "text": "your text here",
          "pattern": "\\byour (?:text|content|copy|title|headline|tagline|description) (?:goes )?here\\b",
          "heuristic": true
        },
        {
          "text": "insert text here",
          "pattern": "\\binsert (?:your )?(?:text|content|copy) here\\b",
          "heuristic": true
        },
        {
          "text": "text goes here",
          "pattern": "\\b(?:text|content|copy) goes here\\b",
          "heuristic": true
        },
        {
          "text": "placeholder text",
          "pattern": "\\bplaceholder (?:text|copy)\\b",
          "heuristic": true
        }
      ]
    },
    "placeholder_identities": {
      "rule": "SLP-13",
      "level": "gate",
      "description": "Stock personal names, fictitious companies and example addresses left in shipped UI. Visibly labelled demo data and input placeholder attributes that show a format (you@example.com) pass.",
      "entries": [
        {
          "text": "Jane Doe",
