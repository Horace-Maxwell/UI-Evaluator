    "generic_hero_phrases": {
      "rule": "SLP-14",
      "level": "gate",
      "table": "B",
      "evidence": "any hit is SLP-14 evidence on its own (generic hero copy)",
      "entries": [
        {
          "text": "Welcome to …",
          "pattern": "^\\s*welcome to\\b"
        },
        {
          "text": "your all-in-one solution",
          "pattern": "\\ball[- ]in[- ]one (?:solution|platform)\\b"
        },
        {
          "text": "Build faster. Ship smarter.",
          "pattern": "\\bbuild faster[.,]?\\s+ship smarter\\b"
        }
      ]
    },
    "aphorism_patterns": {
      "rule": "SLP-14",
      "level": "gate",
      "table": "B",
      "min_count": 3,
      "evidence": "constructions count only from 3 upwards on one page",
      "flags": "u",
      "entries": [
        {
          "name": "Not a X. A Y.",
          "pattern": "(?:^|[.!?]\\s+)[Nn]ot (?:a|an|just a|just an|just) [\\p{L}\\p{N}'’-]+(?:\\s+[\\p{L}\\p{N}'’-]+){0,4}[.!?]\\s+(?:An?|The|It's|It’s|It is)\\s"
        },
        {
          "name": "X. No Y.",
          "pattern": "(?:^|[.!?]\\s+)\\p{Lu}[\\p{L}\\p{N}'’,-]*(?:\\s+[\\p{L}\\p{N}'’,-]+){0,3}\\.\\s+No(?:\\s+[\\p{L}\\p{N}'’-]+){1,4}[.!?]",
          "fragment": true
        },
        {
          "name": "X. Just Y.",
          "pattern": "(?:^|[.!?]\\s+)\\p{Lu}[\\p{L}\\p{N}'’,-]*(?:\\s+[\\p{L}\\p{N}'’,-]+){0,3}\\.\\s+Just(?:\\s+[\\p{L}\\p{N}'’-]+){1,4}[.!?]",
          "fragment": true
        },
        {
          "name": "not just X, it's Y",
          "pattern": "\\b[Nn]ot just [^,.;!?\\n]{1,40}[,;—–-]\\s*(?:it's|it’s|it is|but)\\b"
        },
        {
          "name": "negation pivot: isn't just X — it's Y",
          "pattern": "\\bisn['’]t just\\b[^.!?\\n]{1,40}[,;—–-]\\s*(?:it's|it’s|it is)\\b"
        },
        {
          "name": "negation pivot: it's not X, it's Y",
          "pattern": "\\b(?:[Ii]t['’]s|[Ii]t is|[Tt]his is|[Tt]hat['’]s) not (?:just |about )?[^,.;!?\\n]{1,40}[,;—–-]\\s*(?:it's|it’s|it is)\\b"
        }
      ],
      "description": "Aphoristic constructions (content-copy.md Table B, last row), counted from 3 on one page. The two-part shapes match only short fragments (a lead of at most 4 words, then \"No …\" or \"Just …\" of at most 4 words with no finite verb), because the construction is a slogan shape; ordinary sentences that happen to start with No or Just are prose."
    },
