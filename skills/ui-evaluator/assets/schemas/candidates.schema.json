{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidates.schema.json",
  "title": "Direction candidates for uie roll (METHODS §6)",
  "type": "object",
  "required": [
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "candidates"
    },
    "brief": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "category_default": {
      "type": "string"
    },
    "predictable_opposite": {
      "type": "string"
    },
    "identity_lock": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "id",
          "thesis"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "thesis": {
            "type": "string",
            "minLength": 10
          },
          "world": {
            "type": "string"
          },
          "material_family": {
            "type": "string"
          },
          "fits_attributes": {},
          "risks": {
            "type": "string"
          },
          "conventional": {
            "type": "boolean"
          },
          "axis": {
            "enum": [
              "hierarchy",
              "layout-topology",
              "type-system",
              "colour-strategy",
              "density",
              "structural-decomposition"
            ]
          }
        }
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
