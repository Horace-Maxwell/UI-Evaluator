{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "journey.schema.json",
  "title": "Critical user journey (ARCHITECTURE §8.5)",
  "type": "object",
  "required": [
    "id",
    "title",
    "criticality",
    "persona",
    "goal",
    "scenario",
    "start_state",
    "success_condition",
    "correct_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "criticality": {
      "enum": [
        "critical",
        "core",
        "peripheral"
      ]
    },
    "frequency": {
      "enum": [
        "frequent",
        "regular",
        "occasional",
        "rare"
      ]
    },
    "persona": {
      "type": "object",
      "required": [
        "group"
      ],
      "properties": {
        "group": {
          "type": "string"
        },
        "knows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "does_not_know": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "goal": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "minLength": 10
    },
    "avoided_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_state": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "auth": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "viewport_width": {
          "type": "integer"
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "success_condition": {
      "type": "object",
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "correct_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "goto",
            "click",
            "dblclick",
            "hover",
            "focus",
            "fill",
            "select",
            "check",
            "uncheck",
            "press",
            "tab",
            "scroll",
            "wait",
            "expect",
            "screenshot",
            "viewport",
            "emulate"
          ]
        },
        "url": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "key": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "shift": {
          "type": "boolean"
        },
        "y": {
          "type": "number"
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "visible",
            "hidden",
            "enabled",
            "disabled",
            "focused",
            "checked"
          ]
        },
        "text": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "full_page": {
          "type": "boolean"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "colorScheme": {
          "enum": [
            "light",
            "dark",
            "no-preference"
          ]
        },
        "reducedMotion": {
          "enum": [
            "reduce",
            "no-preference"
          ]
        },
        "forcedColors": {
          "enum": [
            "active",
            "none"
          ]
        }
      },
      "patternProperties": {
        "^_": {}
      }
    }
  }
}
