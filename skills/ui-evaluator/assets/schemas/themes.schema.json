{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "themes.schema.json",
  "title": "Feedback themes (thematic analysis or affinity)",
  "type": "object",
  "required": [
    "themes"
  ],
  "properties": {
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "prevalence",
          "extracts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "prevalence": {
            "type": "object",
            "required": [
              "k",
              "n"
            ],
            "properties": {
              "k": {
                "type": "integer",
                "minimum": 0
              },
              "n": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "participants": {
            "type": "array"
          },
          "extracts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "feedback_id"
              ],
              "properties": {
                "feedback_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "heuristics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "classification": {
            "type": "string"
          }
        }
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
