{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "Study results (QUALITY-BAR G7)",
  "type": "object",
  "required": [
    "study",
    "round"
  ],
  "properties": {
    "study": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "type": "string"
    },
    "moderated": {
      "type": "boolean"
    },
    "think_aloud": {
      "type": "boolean"
    },
    "participants_per_group": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "n_total": {
      "type": "integer"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "n",
          "successes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "successes": {
            "type": "integer",
            "minimum": 0
          },
          "success_ci": {
            "type": "object",
            "properties": {
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "conf": {
                "type": "number"
              }
            }
          },
          "time_geomean": {
            "type": "number"
          },
          "time_ci": {
            "type": "object",
            "properties": {
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "conf": {
                "type": "number"
              }
            }
          },
          "seq_mean": {
            "type": "number"
          },
          "seq_ci": {
            "type": "object",
            "properties": {
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "conf": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "questionnaires": {
      "type": "object"
    },
    "observed_problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "k",
          "n"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "k": {
            "type": "integer",
            "minimum": 0
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": [
              "number",
              "null"
            ]
          },
          "finding": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "retest": {
            "type": "object",
            "properties": {
              "n": {
                "type": "integer"
              },
              "clean": {
                "type": "integer"
              },
              "p": {
                "type": "number"
              },
              "confidence": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "desirability": {
      "type": "object"
    },
    "experiment": {
      "type": "object"
    },
    "nps": {}
  },
  "patternProperties": {
    "^_": {}
  }
}
