{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "UI-Evaluator finding (FRAMEWORK §4.3, ARCHITECTURE §8.3)",
  "type": "object",
  "required": [
    "title",
    "description",
    "problem_type",
    "criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Za-z0-9_.-]+$"
    },
    "fingerprint": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "problem_type": {
      "enum": [
        "single_location",
        "multiple_locations",
        "overall_structure",
        "missing_element"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "impact": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "found_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foundBy"
      }
    },
    "detection": {
      "type": "object",
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "severity": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "source": {
          "enum": [
            "raters",
            "rule",
            "provisional"
          ]
        },
        "ratings": {
          "type": "array"
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "spread": {
          "type": "number"
        },
        "divergent": {
          "type": "boolean"
        },
        "provisional": {
          "type": "boolean"
        }
      }
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "none",
        null
      ]
    },
    "criticality": {
      "enum": [
        "critical",
        "core",
        "peripheral",
        null
      ]
    },
    "ease_of_fix": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4
    },
    "recommendation": {
      "type": "string"
    },
    "factor_notes": {},
    "validity": {
      "enum": [
        "confirmed",
        "needs_verification",
        "trade_off",
        "not_a_problem",
        null
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "rejected",
        "confirmed",
        "open",
        "in_progress",
        "blocked",
        "fixed",
        "verified",
        "resolved",
        "reopened",
        "deferred",
        "disputed",
        "dismissed",
        "wont_fix",
        "stale",
        "split"
      ]
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "at"
        ],
        "properties": {
          "status": {
            "enum": [
              "candidate",
              "rejected",
              "confirmed",
              "open",
              "in_progress",
              "fixed",
              "verified",
              "resolved",
              "reopened",
              "deferred",
              "disputed",
              "dismissed",
              "wont_fix",
              "stale"
            ]
          },
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": [
        "object",
        "null"
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "feedback": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "also_blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked": {
      "description": "Set while the finding waits on a named person's decision (ADR-036); kept, with the answer, after it moves on.",
      "type": "object",
      "required": [
        "on",
        "question"
      ],
      "properties": {
        "on": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "answered_at": {
          "type": "string"
        },
        "answered_by": {
          "type": "string"
        }
      }
    },
    "split_from": {
      "description": "The finding this one was split from (ADR-037).",
      "type": "string"
    },
    "split_into": {
      "description": "The parts a split finding was replaced by (ADR-037).",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "heuristic",
            "cw",
            "wcag",
            "rule",
            "iso",
            "hax",
            "design",
            "principle"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "theme": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "crop": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "journey": {
          "type": "string"
        },
        "step": {
          "type": [
            "integer",
            "string"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": [
                "integer",
                "null"
              ]
            },
            "col": {
              "type": [
                "integer",
                "null"
              ]
            },
            "method": {
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          }
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "measurement",
            "screenshot",
            "probe",
            "trace",
            "aria",
            "console",
            "network",
            "quote",
            "metric",
            "tool",
            "annotation",
            "video",
            "absence",
            "code"
          ]
        },
        "ref": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "value": {}
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "foundBy": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "method": {
          "enum": [
            "HE",
            "CW",
            "critic",
            "a11y",
            "code",
            "tool",
            "feedback",
            "study",
            "verifier",
            "human",
            "pure",
            "klm"
          ]
        },
        "pass": {
          "type": "integer",
          "minimum": 1
        },
        "check": {
          "type": "string"
        },
        "engine": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "factorNotes": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "persistence": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "title",
        "description",
        "problem_type",
        "criteria"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "problem_type": {
          "enum": [
            "single_location",
            "multiple_locations",
            "overall_structure",
            "missing_element"
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "impact": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "found_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foundBy"
          }
        },
        "factor_notes": {
          "$ref": "#/$defs/factorNotes"
        },
        "evidence_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        "recommendation": {
          "type": "string"
        },
        "post_unseal": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "if": {
        "properties": {
          "problem_type": {
            "const": "missing_element"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ]
      },
      "else": {
        "required": [
          "locations"
        ]
      }
    }
  }
}
