{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Run manifest (EVD-01)",
  "type": "object",
  "required": [
    "run",
    "label",
    "created_at",
    "project_root",
    "depth",
    "target_level",
    "scope",
    "tools"
  ],
  "properties": {
    "run": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "project_root": {
      "type": "string"
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "depth": {
      "enum": [
        "quick",
        "standard",
        "rigorous"
      ]
    },
    "target_level": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "routes",
        "matrix"
      ],
      "properties": {
        "routes": {
          "type": "array"
        },
        "matrix": {
          "type": "object"
        },
        "base_url": {
          "type": "string"
        }
      }
    },
    "tools": {
      "type": "object",
      "required": [
        "node",
        "uie"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "uie": {
          "type": "string"
        }
      }
    },
    "evaluators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "agent",
          "isolation",
          "model"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "isolation": {
            "enum": [
              "subagent",
              "process",
              "single-context"
            ]
          },
          "packet_hash": {
            "type": "string"
          }
        }
      }
    },
    "captures": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "integer"
        },
        "invalid": {
          "type": "integer"
        },
        "items": {
          "type": "array"
        }
      }
    },
    "doctor": {
      "type": "object"
    },
    "merge": {
      "type": "object"
    },
    "coverage_matrix": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
