{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcag22.schema.json",
  "title": "WCAG 2.2 A/AA success criteria with UI-Evaluator coverage methods (assets/data/wcag22.json)",
  "type": "object",
  "required": ["schema", "version", "as_of", "source", "criteria"],
  "properties": {
    "schema": { "const": "wcag22" },
    "version": { "type": "integer", "minimum": 1 },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "count": { "const": 55 },
    "levels": { "type": "object", "properties": { "A": { "const": 31 }, "AA": { "const": 24 } } },
    "criteria": {
      "type": "array",
      "minItems": 55,
      "maxItems": 55,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["sc", "level", "name", "verification", "methods", "coverage", "criteria"],
        "properties": {
          "sc": { "type": "string", "pattern": "^[1-4]\\.\\d+\\.\\d+$" },
          "level": { "enum": ["A", "AA"] },
          "name": { "type": "string", "minLength": 3 },
          "verification": { "type": "string", "minLength": 3 },
          "methods": { "type": "array", "minItems": 1, "items": { "enum": ["auto", "scripted", "judged", "human"] } },
          "coverage": { "enum": ["auto", "scripted", "judged", "human"] },
          "criteria": { "type": "array", "items": { "type": "string", "pattern": "^(A11Y|CPY)-\\d{2}$" } },
          "advisory_rules": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^_": {} },
  "additionalProperties": false
}
