{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critic-verdict.schema.json",
  "title": "A design critic's specificity and appeal verdicts, written before detector output is unsealed",
  "type": "object",
  "required": [
    "agent",
    "value",
    "evidence"
  ],
  "properties": {
    "agent": {
      "type": "string"
    },
    "value": {
      "enum": [
        "specific",
        "partly_specific",
        "generic"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "written_at": {
      "type": "string"
    },
    "appeal": {
      "type": "object",
      "description": "ADR-035: written before detector output is unsealed. 'plain' and 'unappealing' list the signs of unfinish in 'unfinished'.",
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "enum": [
            "appealing",
            "plain",
            "unappealing"
          ]
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
