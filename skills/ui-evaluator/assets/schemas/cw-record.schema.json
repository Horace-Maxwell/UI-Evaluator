{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cw-record.schema.json",
  "title": "Cognitive walkthrough record (METHODS §4.2)",
  "type": "object",
  "required": [
    "journey",
    "persona",
    "task",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "cw-record"
    },
    "run": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "journey": {
      "type": "string"
    },
    "persona": {},
    "task": {
      "type": "string"
    },
    "start_state": {},
    "sequence": {
      "type": "array"
    },
    "variant": {
      "enum": [
        "full",
        "streamlined"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "n",
          "action",
          "verdict"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "action": {},
          "answers": {
            "type": "object",
            "patternProperties": {
              "^(q[1-4]|know|progress)$": {
                "type": "object",
                "required": [
                  "answer"
                ],
                "properties": {
                  "answer": {
                    "enum": [
                      "yes",
                      "no"
                    ]
                  },
                  "story": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "array"
                  }
                }
              }
            }
          },
          "verdict": {
            "enum": [
              "would",
              "would_with_effort",
              "would_not"
            ]
          },
          "failure_story": {
            "type": "string"
          },
          "missing": {
            "enum": [
              "knowledge",
              "feedback",
              "both",
              null
            ]
          }
        }
      }
    },
    "overall": {
      "enum": [
        "would",
        "would_with_effort",
        "would_not"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
