{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "Gate criteria data (generated from QUALITY-BAR by tools/build-rules.mjs)",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "rules"
    },
    "version": {
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "gate",
          "title",
          "level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "gate": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7"
            ]
          },
          "title": {
            "type": "string"
          },
          "level": {
            "enum": [
              "gate",
              "advisory"
            ]
          }
        }
      }
    }
  }
}
