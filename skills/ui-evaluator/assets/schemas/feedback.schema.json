{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feedback.schema.json",
  "title": "A normalised feedback item (METHODS §7.8)",
  "type": "object",
  "required": [
    "id",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FB-\\d{4,}$"
    },
    "source": {
      "enum": [
        "usability",
        "survey",
        "tickets",
        "reviews",
        "interviews",
        "analytics",
        "stakeholders",
        "annotations",
        "other"
      ]
    },
    "channel": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "participant": {
      "type": [
        "string",
        "null"
      ]
    },
    "study": {
      "type": [
        "string",
        "null"
      ]
    },
    "task": {
      "type": [
        "string",
        "null"
      ]
    },
    "step": {},
    "outcome": {
      "enum": [
        "success",
        "assisted",
        "failed",
        "abandoned",
        "not_reached",
        null
      ]
    },
    "intervention": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "prompted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ui_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "quote": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "reporter_severity": {
      "description": "The reporter's own severity, never copied into severity: {value, scale, prior}",
      "type": [
        "object",
        "null"
      ]
    },
    "classification": {
      "enum": [
        "problem",
        "bug",
        "preference",
        "feature_request",
        "praise",
        "question",
        "unclassified"
      ]
    },
    "theme": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scrubbed": {
      "type": "boolean"
    },
    "raw_ref": {
      "type": "string"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "agree",
        "disagree",
        "unsure",
        null
      ]
    },
    "finding": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "extra": {
      "type": "object"
    },
    "hash": {
      "type": "string"
    },
    "imported_at": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
