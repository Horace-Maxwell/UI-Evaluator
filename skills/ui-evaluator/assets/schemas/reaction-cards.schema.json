{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reaction-cards.schema.json",
  "title": "Reaction-card starter list for EMP-07 (assets/data/reaction-cards.json)",
  "type": "object",
  "required": ["schema", "version", "as_of", "source", "target", "words"],
  "properties": {
    "schema": { "const": "reaction-cards" },
    "version": { "type": "integer", "minimum": 1 },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "target": { "type": "object", "required": ["size", "negative_share"], "properties": { "size": { "type": "integer", "minimum": 1 }, "negative_share": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "procedure": { "type": "array", "items": { "type": "string" } },
    "words": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["word", "polarity", "brand_tag"],
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "polarity": { "enum": ["positive", "negative"] },
          "brand_tag": { "enum": ["on-brand", "off-brand", null] }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^_": {} },
  "additionalProperties": false
}
