{
  "name": "slot-booking",
  "product": "Dunmore recycling centre booking",
  "description": "A council recycling centre's drop-off slot booking, delivered as a production build: one minified bundle (app.js) and a minified stylesheet, no readable source. Colours are computed at run time from a hue, slot availability and order are decided at run time, and the seeded problems live in timing, geometry, computed colour, runtime order and state (slots that arrive about a second late with nothing loading, the page that jumps when they do, an amber tag that fails contrast in both themes, a grid sized from the window at 320 px, slot buttons with no focus ring, today's started slots offered and refused at the end, a permit rule behind an info button and enforced only at the last step, a hold that lapses silently, a second press that cancels the booking, few-left slots moved to the front against the reading order, a status region made live after its text, Change slot that forgets the day, a slot's end time only in a tooltip, a done page without the booking's day or slot). Reading the bundle gives the strings but not the behaviour (EVALUATION-PLAN §3; a harder companion to tool-library, whose source a session could read). The booking in progress lives in sessionStorage; ?date=&slot=&vehicle=&waste=&permit=&hold=&ref=&status= on any page seeds it so each route opens on its own.",
  "routes": [
    {
      "path": "/",
      "surface": "when",
      "mode": "operate",
      "states": [
        { "name": "default", "actions": [] },
        {
          "name": "date-chosen",
          "actions": [
            { "action": "click", "target": "[data-quick=\"2026-10-17\"]" },
            { "action": "expect", "target": ".slot", "state": "visible" }
          ]
        },
        {
          "name": "slot-chosen",
          "actions": [
            { "action": "click", "target": "[data-quick=\"2026-10-17\"]" },
            { "action": "expect", "target": ".slot", "state": "visible" },
            { "action": "click", "target": ".slot[data-slot=\"09:20\"]" },
            { "action": "expect", "target": ".slot[data-slot=\"09:20\"][aria-pressed=\"true\"]", "state": "visible" }
          ]
        }
      ]
    },
    {
      "path": "/vehicle.html?date=2026-10-17&slot=09:20",
      "surface": "vehicle",
      "mode": "operate",
      "states": [
        { "name": "default", "actions": [] },
        {
          "name": "van",
          "actions": [
            { "action": "click", "target": "[data-vehicle=\"van\"]" },
            { "action": "expect", "target": "#permit", "state": "visible" }
          ]
        },
        {
          "name": "info-open",
          "actions": [
            { "action": "click", "target": "#info" },
            { "action": "expect", "target": "#info-panel", "state": "visible" }
          ]
        },
        {
          "name": "errors",
          "actions": [
            { "action": "click", "target": "role=button[name=\"Next\"]" },
            { "action": "expect", "target": "role=alert", "state": "focused" }
          ]
        }
      ]
    },
    {
      "path": "/confirm.html?date=2026-10-17&slot=09:20&vehicle=car&waste=garden",
      "surface": "confirm",
      "mode": "operate",
      "states": [
        { "name": "default", "actions": [] },
        {
          "name": "errors",
          "actions": [
            { "action": "click", "target": "role=button[name=\"Book this slot\"]" },
            { "action": "expect", "target": "role=alert", "state": "focused" }
          ]
        }
      ]
    },
    {
      "path": "/confirm.html?date=2026-10-17&slot=09:20&vehicle=car&waste=garden&hold=expired",
      "surface": "confirm",
      "mode": "operate",
      "states": [
        {
          "name": "expired",
          "actions": [
            { "action": "fill", "target": "#reg", "value": "AB12 CDE" },
            { "action": "fill", "target": "#name", "value": "Test Resident" },
            { "action": "fill", "target": "#phone", "value": "07700 900123" },
            { "action": "fill", "target": "#postcode", "value": "DN4 1AA" },
            { "action": "click", "target": "role=button[name=\"Book this slot\"]" },
            { "action": "expect", "text": "no longer available" }
          ]
        }
      ]
    },
    {
      "path": "/done.html?ref=DR-204117&date=2026-10-17&slot=09:20&vehicle=car&waste=garden&status=booked",
      "surface": "done",
      "mode": "read",
      "states": [
        { "name": "default", "actions": [] }
      ]
    },
    {
      "path": "/done.html?ref=DR-204117&date=2026-10-17&slot=09:20&vehicle=car&waste=garden&status=cancelled",
      "surface": "done",
      "mode": "read",
      "states": [
        { "name": "cancelled", "actions": [] }
      ]
    }
  ],
  "journeys": ["book-a-slot", "change-slot"],
  "themes": ["light", "dark"],
  "locales": { "list": ["en-GB"], "default": "en-GB" }
}
